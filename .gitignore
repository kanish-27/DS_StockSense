# ===== Data (raw/private datasets are NOT committed) =====
# Folder structure is kept via .gitkeep files.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# TODO(team): if the cleaned master dataset is small and allowed to be shared,
# un-ignore it explicitly, e.g.  !data/processed/master_dataset.parquet

# ===== Generated model artifacts =====
models/*
!models/.gitkeep
*.pkl
*.pickle
*.joblib
*.h5
*.onnx

# ===== Generated reports (keep folder, ignore bulky outputs) =====
reports/figures/
