# Copy this file to `.env` and adjust values locally. Never commit `.env`.
# No secrets are required at this stage — these are optional path overrides.
# If unset, defaults defined in src/common/config.py are used.

# Folder containing the raw dataset files supplied for the hackathon
STOCKSENSE_RAW_DATA_DIR=data/raw

# Folder where the cleaned master dataset is written
STOCKSENSE_PROCESSED_DATA_DIR=data/processed

# Folder where trained model artifacts are saved
STOCKSENSE_MODELS_DIR=models

# Random seed shared by all modules for reproducibility
STOCKSENSE_RANDOM_SEED=42
